{
  "name": "@devalparikh/autoeval",
  "version": "0.4.0-private.1",
  "description": "Server-only, application trace capture with automatic versioning",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devalparikh/auto-eval.git",
    "directory": "packages/trace-feed"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
