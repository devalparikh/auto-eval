# DESIGN ONLY: the current SDK/Lifty integration does not read these variables.
# Future public env-initializer contract; this is not an activation/configuration file.
# Server-only values. No NEXT_PUBLIC_ prefix. No real tokens or endpoints here.
AUTOEVAL_ENABLED=false
AUTOEVAL_ENDPOINT=
AUTOEVAL_INGEST_KEY=
AUTOEVAL_EXPERIMENT_ID=
AUTOEVAL_SOURCE=
AUTOEVAL_REQUEST_TIMEOUT_MS=500
# Separate source-consent synchronization credential, not an admin credential:
AUTOEVAL_CONSENT_KEY=
# Optional read-only credential for a distinct approved reporter, not capture:
AUTOEVAL_READ_KEY=
