# Candidate SDK reads these when createCaptureFromEnv({policy, experiment}) is called.
# Unpublished; disabled until approved installation and explicit per-user consent.
# Server-only values. No NEXT_PUBLIC_ prefix. No real tokens or endpoints here.
AUTOEVAL_ENABLED=false
# Hosted route: https://INSTANCE/api/backend/v2/traces
AUTOEVAL_ENDPOINT=
AUTOEVAL_INGEST_KEY=
# Explicitly choose production or synthetic; there is no default source.
AUTOEVAL_SOURCE=
AUTOEVAL_REQUEST_TIMEOUT_MS=2000
# Build-only GitHub Packages read token; use a token reference in .npmrc.
AUTOEVAL_NPM_TOKEN=
# Consent is app-owned, off by default, passed to capture.begin({consent}).
# The app key registers policy, experiment and consent grants automatically.
